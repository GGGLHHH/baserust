    "/api/v1/frontend/contents": {
      "get": {
        "operationId": "list_contents",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ContentResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "当前用户的内容列表"
          },
          "401": {
            "content": {
