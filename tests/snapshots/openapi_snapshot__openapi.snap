                }
              }
            },
            "description": "校验失败"
          }
        },
        "security": [
          {
            "oauth2": [
              "contents:write"
            ]
          }
        ],
        "summary": "建内容(仅 content 行,status=created)。需 `contents:write`。owner_id = 当前用户。",
        "tags": [
          "contents"
        ]
      }
    },
    "/api/v1/frontend/contents/upload": {
      "post": {
        "operationId": "upload_content",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "description": "一次性上传的 multipart 表单形状(只为 OpenAPI 文档,handler 逐字段手解)。",
                "properties": {
                  "document_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "file": {
                    "description": "文件本体(必填,带 filename + content-type)。",
                    "format": "binary",
                    "type": "string"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "tags": {
                    "description": "逗号分隔。",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            },
            "description": "已上传(content + object 皆 uploaded)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "multipart 解析失败"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 contents:write 权限 / 没有当前租户(tenant_required)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "缺 file 部分"
          }
        },
        "security": [
          {
            "oauth2": [
              "contents:write"
            ]
          }
        ],
        "summary": "一次性上传(multipart/form-data):建 content + object 行、推字节、同步元数据、翻状态。需 `contents:write`。\n表单字段:`file`(必填,带 filename + content-type)、`name`、`tags`(逗号分隔)、`document_type`。\n内容落当前租户(令牌里的租户)。",
        "tags": [
          "contents"
        ]
      }
    },
    "/api/v1/frontend/contents/upload-url": {
      "post": {
        "operationId": "prepare_upload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrepareUploadResponse"
                }
              }
            },
            "description": "账已建(created);upload_url=null 时回退一步上传"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 contents:write 权限 / 没有当前租户(tenant_required)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败"
          }
        },
        "security": [
          {
            "oauth2": [
              "contents:write"
            ]
          }
        ],
        "summary": "两步上传①:建账 + 占格 + 签直传凭证(字节不过 app)。需 `contents:write`。\n`upload_url = null` → 后端不支持,回退 multipart 一步上传。传完调 confirm-upload 销账。",
        "tags": [
          "contents"
        ]
      }
    },
    "/api/v1/frontend/contents/{id}": {
      "delete": {
        "operationId": "delete_content",
        "parameters": [
          {
            "description": "content id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "已软删除"
          },
          "401": {
            "content": {
