        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            },
            "description": "已更新"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 widgets:write 权限 / 没有当前租户(tenant_required)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "不存在 / 非本人 / 别的租户的"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "name 撞已有(本租户存活行内唯一)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败"
          }
        },
        "security": [
          {
            "oauth2": [
              "widgets:write"
            ]
          }
        ],
        "summary": "更新 widget(改名,需 `widgets:write`);updated_by 来自 `AuditContext`,updated_at 由触发器自动盖。",
        "tags": [
          "widgets"
        ]
      }
    },
    "/api/v1/public/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "登录成功,token 写入 httponly cookie"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "用户名/邮箱或密码错误(同码同文案,防枚举)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "已登出,清除 cookie(幂等)"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "刷新成功,新 token 写入 cookie"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "refresh cookie 无效/过期/已撤销"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/auth/register": {
      "post": {
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "注册成功,token 写入 httponly cookie"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "用户名或邮箱已占用"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/client-errors": {
      "post": {
        "operationId": "report_client_errors",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientErrorBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "已收下(超出限流的部分静默丢弃)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "JSON 格式不对(如 kind 不认识),或请求体超过 64 KB"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "条数不在 1~10 之间"
          }
        },
        "summary": "前端错误上报(免登录)。进后台「系统监控 → 日志」,服务为「前端」。超出限流的部分静默丢弃,同样回 204。",
        "tags": [
          "monitoring"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "兼容别名 = livez,保留早期 `/health` 引用不破。",
        "tags": [
          "health"
        ]
      }
    },
    "/livez": {
      "get": {
        "operationId": "livez",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "存活探针:进程活着即 ok,**不查依赖**(给 livenessProbe;失败会被重启)。",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            },
            "description": "全部依赖可用"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            },
            "description": "至少一项依赖不可用"
          }
        },
        "summary": "就绪探针:并发检查本进程的全部依赖(各 schema 连接池 `select 1`、NATS 连接状态,每项 2s 超时),\n任一项不可用 → 503。失败只让流量绕开本实例(不重启),与 livez 分工不同。",
        "tags": [
          "health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "健康检查",
      "name": "health"
    },
    {
      "description": "示例资源",
      "name": "widgets"
    },
    {
      "description": "内容/对象存储:CRUD / 上传下载 / 元数据",
      "name": "contents"
    },
    {
      "description": "用户资料:姓名/电话/头像(头像经 content 富化)",
      "name": "profiles"
    },
    {
      "description": "认证:注册/登录/刷新/登出",
      "name": "auth"
    },
    {
      "description": "当前用户:资料/改密/注销",
      "name": "me"
    },
    {
      "description": "后台:管理端登录/当前管理员",
      "name": "admin"
    },
    {
      "description": "后台账号管理(平台级):CRUD/平台角色/密码/资料/认证审计",
      "name": "users"
    },
    {
      "description": "平台租户管理(平台级):建 / 改名 / 停用租户,管理任意租户的成员",
      "name": "tenants"
    },
    {
      "description": "本租户成员管理(租户级):成员列表 / 按用户名加入已有账号 / 设租户角色 / 移出",
      "name": "members"
    },
    {
      "description": "系统监控:后台监控页(依赖健康/流量/数据库/后台任务/进程资源)与前端错误上报",
      "name": "monitoring"
    }
  ]
}
