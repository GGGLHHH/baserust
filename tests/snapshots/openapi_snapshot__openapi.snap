          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 users:admin 权限 / 目标持平台角色而无 platform:roles"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "缺 file 部分 / 非 image"
          }
        },
        "security": [
          {
            "oauth2": [
              "users:admin"
            ]
          }
        ],
        "summary": "后台传某用户头像(multipart 表单,`file` 部分为图片)。上传即绑定(auto-bind):\ncontent owner = 目标用户,保留现有 display_name/phone,返回更新后的资料。归 `users:admin`。",
        "tags": [
          "users"
        ]
      }
    },
