    "/api/v1/admin/monitoring": {
      "get": {
        "operationId": "get_monitoring",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitoringReport"
                }
              }
            },
            "description": "各进程的监控数据(生产分进程时含 app 与 idm)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 ops:read 权限(superadmin 独占)"
          }
        },
        "security": [
          {
            "oauth2": [
              "ops:read"
            ]
          }
        ],
        "summary": "系统监控:每个进程的依赖健康、请求量 / 错误 / 耗时、数据库操作耗时、连接池、后台任务(outbox / projector)、\nSSE 在线数、进程资源,以及最近一段时间(默认 1 小时,15 秒一个点)的历史曲线。数据只在进程内存里,重启清空。",
        "tags": [
          "monitoring"
        ]
      }
    },
    "/api/v1/admin/monitoring/history": {
      "get": {
        "operationId": "get_monitoring_history",
        "parameters": [
          {
            "description": "时间范围,默认 24h。",
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/HistoryRange"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryReport"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 ops:read 权限(superadmin 独占)"
          }
        },
        "security": [
          {
            "oauth2": [
              "ops:read"
            ]
          }
        ],
        "summary": "历史趋势:按时间范围(24 小时 ~ 1 年)给出各进程的曲线、范围合计,以及接口 / 数据库操作的明细。\n数据来自 ops 数据库(分钟级留 15 天、小时级留 13 个月、明细留 30 天);没配时只有进程内存里最近一段。",
        "tags": [
          "monitoring"
        ]
      }
    },
    "/api/v1/admin/monitoring/logs": {
      "get": {
        "operationId": "list_monitoring_logs",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "最低级别:`WARN` = WARN + ERROR,`ERROR` = 只看 ERROR。不给 = 全部。",
            "in": "query",
            "name": "level",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Severity"
            }
          },
          {
            "in": "query",
            "name": "instance",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/InstanceRole"
            }
          },
          {
            "description": "服务:app(业务)/ idm(认证)。单进程开发时按接口前缀 / 代码模块推断。",
            "in": "query",
            "name": "service",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Service"
            }
          },
          {
            "description": "消息 / 模块 / 接口的子串,不区分大小写。",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "精确匹配请求 id(响应头 `x-request-id`)。",
            "in": "query",
            "name": "request_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "页码,从 1 开始。",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "每页条数,1~200,默认 50。",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_LogRecordView"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 ops:read 权限(superadmin 独占)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "参数不合法(size 超出 1~200 / from 晚于 to)"
          }
        },
        "security": [
          {
            "oauth2": [
              "ops:read"
            ]
          }
        ],
        "summary": "日志:WARN 及以上的日志、失败请求(5xx)和慢请求(≥1 秒),按时间倒序分页。保留 15 天。",
        "tags": [
          "monitoring"
        ]
      }
    },
    "/api/v1/admin/platform/tenants": {
      "get": {
        "operationId": "list_tenants",
        "parameters": [
          {
            "description": "提供 ⇒ offset 模式(可跳页),1-based。",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "提供 ⇒ cursor 模式;opaque token,原样回传、勿解析。空值 `cursor=` = 首页。\nserde_html_form 基座(见 infra/http/extract.rs)会把空值 Option 解成 None,丢掉\n\"cursor 模式首页\"的表达 —— 自定义 deserializer 保住 `Some(\"\")`。",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "每页条数,两模式共用;越界自动 clamp 到 [1,100]。",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "仅 offset 有意义:是否计算 total(默认 true)。",
            "in": "query",
            "name": "with_total",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_TenantView"
                }
              }
            },
            "description": "租户分页列表"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 tenants:admin 权限(平台级)"
          }
        },
        "security": [
          {
            "oauth2": [
              "tenants:admin"
            ]
          }
        ],
        "summary": "租户列表(存活租户,按创建序)。默认 offset;带 `cursor` 切 keyset。",
        "tags": [
          "tenants"
        ]
      },
      "post": {
        "operationId": "create_tenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantView"
                }
              }
            },
            "description": "已创建"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 tenants:admin 权限"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "slug 已被占用(含已删除的租户,slug 不复用)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败(slug / name 不合规)"
          }
        },
        "security": [
          {
            "oauth2": [
              "tenants:admin"
            ]
          }
        ],
        "summary": "建租户(status = active,还没有成员;用 PUT 成员接口指定第一个管理员)。",
        "tags": [
          "tenants"
        ]
      }
    },
