---
source: tests/openapi_snapshot.rs
expression: spec
---
{
  "components": {
    "schemas": {
      "AddMemberRequest": {
        "description": "按**完整用户名**把已有账号加进本租户(精确匹配;查不到 → 404 `account_not_found`)。\n`roles` 只能是租户角色(平台角色 → 422)。",
        "properties": {
          "roles": {
            "items": {
              "$ref": "#/components/schemas/TenantRoleName"
            },
            "type": "array"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "roles"
        ],
        "type": "object"
      },
      "AdminUserView": {
        "description": "后台用户视图:身份(idm.users)+ 角色(idm)+ 富化的资料(app.profiles;缺/分进程降级 → null)。",
        "properties": {
          "avatar_url": {
            "description": "富化:相对头像端点路径(悬空/分进程 → null)。",
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "display_name": {
            "description": "富化:app.profiles 的显示名(悬空/分进程 → null)。",
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "email_verified": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "roles": {
            "description": "idm 角色名(全量;闭集,生成前端 union)。",
            "items": {
              "$ref": "#/components/schemas/RoleName"
            },
            "type": "array"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email_verified",
          "created_at",
          "roles"
        ],
        "type": "object"
      },
      "AuthChannel": {
        "description": "认证渠道闭集(`public` 前台 / `admin` 后台)。同 `AuthEventType` 头注:存储值不变,只加读侧\n强类型;无 `#[serde(other)]` 兜底,原因同上(唯一写者是本仓 emit)。",
        "enum": [
          "public",
          "admin"
        ],
        "type": "string"
      },
      "AuthEventRow": {
        "description": "读模型行(admin 端点返回 / SSE 帧 data)。",
        "properties": {
          "actor": {
            "type": [
              "string",
              "null"
            ]
          },
          "browser": {
            "type": [
              "string",
              "null"
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/AuthChannel"
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_type": {
            "$ref": "#/components/schemas/AuthEventType"
          },
          "failure_reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/FailureReason"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "identifier_attempted": {
            "type": [
              "string",
              "null"
            ]
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurred_at": {
            "format": "date-time",
            "type": "string"
          },
          "os": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "$ref": "#/components/schemas/AuthOutcome"
          },
          "session_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "tenant_id": {
            "description": "事件所在的租户(登录进租户 / 切换 / 刷新该租户的会话等);登录失败等没有租户的事件为 null。",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "event_type",
          "occurred_at",
          "channel",
          "outcome"
        ],
        "type": "object"
      },
      "AuthEventType": {
        "description": "认证审计事件类型闭集。存储值不变(仍是 `emit` 写的 `\"auth.xxx\"` 字符串,免数据迁移),\n这里只是给它上一层强类型:emit 侧编译期防手滑字面量,读侧 utoipa 生成前端可辨识联合类型。\n故意不设 `#[serde(other)]` 兜底 —— 该列只由本仓 `auth::emit` 写入(闭集只增不改),\n出现未知值本身就是数据异常,该让它在解码处炸出来而不是悄悄吞掉。",
        "enum": [
          "auth.login_succeeded",
          "auth.login_failed",
          "auth.admin_access_denied",
          "auth.refreshed",
          "auth.logged_out",
          "auth.logout_all",
          "auth.password_changed",
          "auth.registered",
          "auth.account_deleted",
          "auth.tenant_switched"
        ],
        "type": "string"
      },
      "AuthKpi": {
        "properties": {
          "failed_count": {
            "format": "int64",
            "type": "integer"
          },
          "failed_delta": {
            "format": "double",
            "type": "number"
          },
          "success_rate": {
            "format": "double",
            "type": "number"
          },
          "total_delta": {
            "description": "(当前 - 上个等长窗口) / 上个等长窗口;上个窗口为 0 时记 0.0(无基数,不作 +∞/NaN)。",
            "format": "double",
            "type": "number"
          },
          "total_events": {
            "format": "int64",
            "type": "integer"
          },
          "unique_ips": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "total_events",
          "failed_count",
          "unique_ips",
          "success_rate",
          "total_delta",
          "failed_delta"
        ],
        "type": "object"
      },
      "AuthOutcome": {
        "description": "认证结果闭集(`success` / `failure`)。同上头注。",
        "enum": [
          "success",
          "failure"
        ],
        "type": "string"
      },
      "AuthStats": {
        "properties": {
          "activity": {
            "items": {
              "$ref": "#/components/schemas/StatBucket"
            },
            "type": "array"
          },
          "kpi": {
            "$ref": "#/components/schemas/AuthKpi"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/ReasonCount"
            },
            "type": "array"
          },
          "top_ips": {
            "items": {
              "$ref": "#/components/schemas/IpStat"
            },
            "type": "array"
          },
          "types": {
            "items": {
              "$ref": "#/components/schemas/TypeCount"
            },
            "type": "array"
          }
        },
        "required": [
          "activity",
          "reasons",
          "types",
          "top_ips",
          "kpi"
        ],
        "type": "object"
      },
      "ChangePasswordRequest": {
        "description": "修改密码。",
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "type": "object"
      },
      "ClientErrorBatch": {
        "description": "一批前端错误(1~10 条)。",
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ClientErrorReport"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "ClientErrorKind": {
        "description": "错误来源。",
        "enum": [
          "error",
          "unhandled_rejection",
          "render"
        ],
        "type": "string"
      },
      "ClientErrorReport": {
        "description": "一条前端错误。",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ClientErrorKind"
          },
          "message": {
            "description": "错误消息。",
            "type": "string"
          },
          "page": {
            "description": "出错时的页面路径(`location.pathname`;带了 query / hash 也会被去掉)。",
            "type": [
              "string",
              "null"
            ]
          },
          "release": {
            "description": "前端版本(构建号)。",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "description": "出错的脚本位置(`文件:行:列`)。",
            "type": [
              "string",
              "null"
            ]
          },
          "stack": {
            "description": "调用栈。",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "type": "object"
      },
      "ContentMetadataResponse": {
        "description": "内容元数据的对外响应(投影 `content::ContentMetadata`)。",
        "properties": {
          "checksum": {
            "type": [
              "string",
              "null"
            ]
          },
          "checksum_algorithm": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_id": {
            "format": "uuid",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "file_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "file_size": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "metadata": {
            "description": "自由表单 JSONB。"
          },
          "mime_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "content_id",
          "tags",
          "metadata",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ContentResponse": {
        "description": "内容主体的对外响应(投影 `content::Content`;`status` 投影成闭集视图)。",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "derivation_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner_id": {
            "format": "uuid",
            "type": "string"
          },
          "owner_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatusView",
            "description": "生命周期状态(闭集,生成前端 union)。"
          },
          "tenant_id": {
            "description": "所属租户;`null` = 个人内容(不属于任何租户,如头像 —— 本模块的端点看不到个人内容,\n但形状上如实反映库的 `Option`)。",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner_id",
          "status",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ContentStatusView": {
        "description": "内容生命周期状态闭集(镜像 `content::ContentStatus` 的 wire 串;库零 HTTP 不 derive\nToSchema,视图枚举归消费方 —— 见 closed-enums skill)。`From` 穷尽匹配:库加变体这里编译错。",
        "enum": [
          "created",
          "uploading",
          "uploaded",
          "processing",
          "processed",
          "failed",
          "archived"
        ],
        "type": "string"
      },
      "CreateContentRequest": {
        "description": "建内容的入参(仅建 content 行,不碰对象/字节)。owner_id 来自认证主体、租户来自令牌(都不入参)。",
        "properties": {
          "derivation_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner_type": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "CreateTenantRequest": {
        "description": "建租户。slug:1-63 个小写字母 / 数字 / 连字符,不以连字符开头或结尾,全局唯一(含已删的);name 1..=100。",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name"
        ],
        "type": "object"
      },
      "CreateUserRequest": {
        "description": "建号(原子含角色)。username 1..=100、email 合法、password ≥3(领域校验)。",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "type": "string"
          },
          "roles": {
            "description": "角色 id(空 = 不授角色);未知 id → 422。",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "roles"
        ],
        "type": "object"
      },
      "CreateWidget": {
        "description": "创建 widget 的入参(name 1..=100 字符,由领域校验)。审计字段不入参。",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CurrentTenantView": {
        "description": "当前租户的展示信息(`GET /permissions/me` 的 `tenant`)。",
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "同上(租户改名后,到 token 过期 / refresh 前仍是旧名)。",
            "type": "string"
          },
          "slug": {
            "description": "来自登录 / 切换时签进 token 的值;降权令牌没有 → 空串。",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ],
        "type": "object"
      },
      "DbOperationStats": {
        "description": "单个数据库操作的统计(来自仓储方法上的 `pg.*` span)。",
        "properties": {
          "calls": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "description": "如 `pg.widgets.list`。",
            "type": "string"
          },
          "p50_ms": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "p95_ms": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "calls"
        ],
        "type": "object"
      },
      "DeleteMeRequest": {
        "description": "注销账户(需密码确认)。",
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "DependencyCheck": {
        "description": "单项依赖检查。",
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "latency_ms": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "description": "`db_app` / `db_idm` / `db_content` / `db_search` / `nats`。",
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok",
          "latency_ms"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "统一错误响应体。pub + ToSchema:让这个契约出现在 OpenAPI,前端 codegen 能看到错误形状。",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "机器可读错误类别(闭集)"
          },
          "error": {
            "description": "给人看的安全消息 —— 不含 SQL/解析器/路径等任何内部原始措辞",
            "type": "string"
          }
        },
        "required": [
          "code",
          "error"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "错误机器码闭集(前端按它分支;闭集生成前端 union,见 closed-enums skill)。",
        "enum": [
          "not_found",
          "validation",
          "bad_request",
          "unauthorized",
          "conflict",
          "forbidden",
          "tenant_required",
          "account_not_found",
          "internal",
          "timeout",
          "rate_limited"
        ],
        "type": "string"
      },
      "FailureReason": {
        "description": "失败原因闭集。同上头注;`account_locked`/`rate_limited` 目前 emit 侧未产出(预留取值,\n闭集只增不改 —— 出现才炸,不提前拒绝合法但暂未使用的取值)。",
        "enum": [
          "unknown_user",
          "bad_password",
          "no_admin_perm",
          "account_locked",
          "rate_limited"
        ],
        "type": "string"
      },
      "HistoryInstance": {
        "properties": {
          "db_operations": {
            "items": {
              "$ref": "#/components/schemas/DbOperationStats"
            },
            "type": "array"
          },
          "points": {
            "description": "时间升序;没有数据的时间段(进程没跑)不出点。",
            "items": {
              "$ref": "#/components/schemas/HistoryPoint"
            },
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/InstanceRole"
          },
          "routes": {
            "items": {
              "$ref": "#/components/schemas/RouteStats"
            },
            "type": "array"
          },
          "traffic": {
            "$ref": "#/components/schemas/TrafficSummary"
          }
        },
        "required": [
          "role",
          "traffic",
          "points",
          "routes",
          "db_operations"
        ],
        "type": "object"
      },
      "HistoryPoint": {
        "description": "历史曲线上的一个点。",
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "cpu_percent": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "db_calls": {
            "format": "int64",
            "minimum": 0,
