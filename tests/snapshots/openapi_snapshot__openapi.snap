      },
      "SetContentMetadataRequest": {
        "description": "设置内容元数据(全量替换,upsert)。\n\n**无 `mime_type` 字段 —— 它是服务端所有物**(上传时由字节的实际 Content-Type 定,见\n`into_input`)。理由是安全而非洁癖:presign 出的 URL 只 override disposition,浏览器拿到的\nContent-Type 恒是**对象上传时存进 S3 的那个**;而 inline 安全闸(`is_safe_inline_mime`)与头像\n栅格白名单读的都是**这张表**的 mime。两者若能分叉,攻击者就能 `text/html` 上传、改 mime 成\n`image/png` 骗过闸门,再经 presign 拿回 `Content-Type: text/html` + inline = 存储型 XSS。\n让 mime 不可改,分叉就不存在。",
        "properties": {
          "checksum": {
            "type": [
              "string",
              "null"
            ]
          },
          "checksum_algorithm": {
            "type": [
              "string",
              "null"
            ]
          },
          "file_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "file_size": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "metadata": {
            "description": "自由表单 JSONB(省略 → `{}`)。"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "tags"
        ],
        "type": "object"
      },
      "SetRolesRequest": {
        "description": "全量设角色(原子替换)。传角色 id;未知 id → 422。",
        "properties": {
          "roles": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "roles"
        ],
        "type": "object"
      },
      "Severity": {
        "description": "日志级别(只存 WARN 及以上)。",
        "enum": [
          "WARN",
          "ERROR"
        ],
        "type": "string"
      },
      "SortOrder": {
        "description": "排序方向(线格式)。默认 `Desc`(最新/最大在前)。",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "SseStatus": {
        "description": "SSE 推送流的在线连接数。",
        "properties": {
          "connections": {
            "format": "int64",
            "type": "integer"
          },
          "stream": {
            "type": "string"
          }
        },
        "required": [
          "stream",
          "connections"
        ],
        "type": "object"
      },
      "StatBucket": {
        "description": "仪表盘统计(admin `/auth-events/stats`)。时间序列 + 各维度 group-by 计数。",
        "properties": {
          "failure": {
            "format": "int64",
            "type": "integer"
          },
          "success": {
            "format": "int64",
            "type": "integer"
          },
          "t": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "t",
          "success",
          "failure"
        ],
        "type": "object"
      },
      "SwitchTenantRequest": {
        "description": "切换当前租户(`POST /auth/switch-tenant`)。只能切到自己是**有效成员**的租户(成员 active + 租户 active)。",
        "properties": {
          "tenant_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "tenant_id"
        ],
        "type": "object"
      },
      "TenantRoleName": {
        "description": "租户角色闭集(成员关系上能授的角色;平台角色不在内)",
        "enum": [
          "admin",
          "user"
        ],
        "type": "string"
      },
      "TenantStatus": {
        "description": "租户状态闭集",
        "enum": [
          "active",
          "suspended"
        ],
        "type": "string"
      },
      "TenantView": {
        "description": "租户。`slug` 建后不可改、删除后也不复用。",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TenantStatus"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "status",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "TrafficSummary": {
        "description": "窗口内的请求汇总。",
        "properties": {
          "errors_4xx": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "errors_5xx": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "p50_ms": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "p95_ms": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "p99_ms": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "requests": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "requests",
          "errors_4xx",
          "errors_5xx"
        ],
        "type": "object"
      },
      "TypeCount": {
        "description": "`types` group-by 计数的强类型版本。",
        "properties": {
          "count": {
            "format": "int64",
            "type": "integer"
          },
          "key": {
            "$ref": "#/components/schemas/AuthEventType"
          }
        },
        "required": [
          "key",
          "count"
        ],
        "type": "object"
      },
      "UpdateContentRequest": {
        "description": "**全量更新**内容可编辑字段(PUT 语义:都替换;tenant/owner/status/derivation 不动)。",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner_type": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpdateMeRequest": {
        "description": "**全量更新**当前用户(PUT 语义)。username 必填;email 给值=设置、给 null 或缺省=清空。",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "type": "object"
      },
      "UpdateTenantRequest": {
        "description": "改租户(PUT 全量:名称 + 状态;slug 不可改)。`status = suspended` 即停用(立即吊销该租户的会话)。",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TenantStatus"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "UpdateUserRequest": {
        "description": "改身份(PUT 全量)。`email=None` 即清空(替换 email 会重置 email_verified,idm 语义)。",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "type": "object"
      },
      "UpdateWidget": {
        "description": "更新 widget 的入参(当前只改名,全量替换)。",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "UploadResponse": {
        "description": "一次性上传的对外响应(内容 + 其主对象)。投影 `content::UploadOutcome`。",
        "properties": {
          "content": {
            "$ref": "#/components/schemas/ContentResponse"
          },
          "object": {
            "$ref": "#/components/schemas/ObjectResponse"
          }
        },
        "required": [
          "content",
          "object"
        ],
        "type": "object"
      },
      "UserBrief": {
        "description": "富化用的用户瘦快照(只含 widget 展示要的字段)。",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ],
        "type": "object"
      },
      "UserResponse": {
        "description": "当前用户(me / 登录注册响应)。token 不进此体(走 httponly cookie)。",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "email_verified": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "roles": {
            "description": "角色名(闭集,生成前端 union)。",
            "items": {
              "$ref": "#/components/schemas/RoleName"
            },
            "type": "array"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email_verified",
          "roles"
        ],
        "type": "object"
      },
      "UserSortField": {
        "description": "排序字段(白名单,防注入)。只排 primary-schema(idm.users)自己的列。",
        "enum": [
          "created_at",
          "username",
          "email",
          "display_name"
        ],
        "type": "string"
      },
      "Widget": {
        "description": "一个 widget(示例资源)+ 基础审计字段。时间是 RFC3339。",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_by": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "WidgetEvent": {
        "description": "widget 变更事件(SSE 帧 data / 总线负载)。帧的 event name = `type` 标签(created/updated/deleted)。\n`tenant_id` = 事件所属租户:总线跨实例扇出(PG NOTIFY / NATS)时靠它让订阅侧先按租户过滤;\nSSE 帧里它总是订阅者自己的当前租户(别的租户的帧在 handler 里就跳过了)。",
        "oneOf": [
          {
            "properties": {
              "tenant_id": {
                "format": "uuid",
                "type": "string"
              },
              "type": {
                "enum": [
                  "created"
                ],
                "type": "string"
              },
              "widget": {
                "$ref": "#/components/schemas/Widget"
              }
            },
            "required": [
              "tenant_id",
              "widget",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "tenant_id": {
                "format": "uuid",
                "type": "string"
              },
              "type": {
                "enum": [
                  "updated"
                ],
                "type": "string"
              },
              "widget": {
                "$ref": "#/components/schemas/Widget"
              }
            },
            "required": [
              "tenant_id",
              "widget",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "created_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "tenant_id": {
                "format": "uuid",
                "type": "string"
              },
              "type": {
                "enum": [
                  "deleted"
                ],
                "type": "string"
              }
            },
            "required": [
              "tenant_id",
              "id",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "WidgetSortField": {
        "description": "列表排序字段(白名单)。默认 `created_at`。",
        "enum": [
          "created_at",
          "name"
        ],
        "type": "string"
      },
      "WidgetStats": {
        "description": "计数响应(公开 stats / 我的计数 共用)。",
        "properties": {
          "total": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      },
      "WidgetView": {
        "description": "`Widget` + 富化的 created_by 用户(脏值/已删/无 → `null`)。",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "created_by": {
            "description": "原审计主体标识(actor id 字符串),保留以便排错/审计。",
            "type": [
              "string",
              "null"
            ]
          },
          "created_by_user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserBrief",
                "description": "富化:created_by 解析到的用户。脏值('system'/非 UUID)、已软删用户 → `None`。"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_by": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "oauth2": {
        "description": "JWT 认证。Token 由 POST /api/v1/public/auth/login(JSON identifier+password)签发,经 httponly `access_token` cookie 优先、`Authorization: Bearer <token>` 兜底两种方式发送。scopes 为 baserust 权限(由 role 授予;降权令牌有效 scope = role 权限 ∩ per-token scope)。注:本服务无独立 OAuth2 授权服务器,此 password flow 仅为对上述登录的文档映射,交互式 Authorize 不保证可直接调通。",
        "flows": {
          "password": {
            "refreshUrl": "/api/v1/public/auth/refresh",
            "scopes": {
              "admin:login": "login admin",
              "audit:read": "read audit",
              "contents:delete": "delete contents",
              "contents:read": "read contents",
              "contents:read:all": "read contents (all)",
              "contents:write": "write contents",
              "contents:write:all": "write contents (all)",
              "members:admin": "admin members",
              "members:read": "read members",
              "ops:read": "read ops",
              "platform:roles": "roles platform",
              "profiles:read": "read profiles",
              "profiles:write": "write profiles",
              "profiles:write:all": "write profiles (all)",
              "tenants:admin": "admin tenants",
              "users:admin": "admin users",
              "widgets:delete": "delete widgets",
              "widgets:read": "read widgets",
              "widgets:read:all": "read widgets (all)",
              "widgets:write": "write widgets",
              "widgets:write:all": "write widgets (all)"
            },
            "tokenUrl": "/api/v1/public/auth/login"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "description": "Rust 脚手架",
    "license": {
      "name": ""
    },
    "title": "baserust API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/auth/auth-events": {
      "get": {
        "operationId": "list_auth_events",
        "parameters": [
          {
            "description": "提供 ⇒ offset 模式(可跳页),1-based。",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "提供 ⇒ cursor 模式;opaque token,原样回传、勿解析。空值 `cursor=` = 首页。\nserde_html_form 基座(见 infra/http/extract.rs)会把空值 Option 解成 None,丢掉\n\"cursor 模式首页\"的表达 —— 自定义 deserializer 保住 `Some(\"\")`。",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "每页条数,两模式共用;越界自动 clamp 到 [1,100]。",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "仅 offset 有意义:是否计算 total(默认 true)。",
            "in": "query",
            "name": "with_total",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "事件类型(闭集;未知值在 Query 提取器被拒 → 400 bad_request,而非静默空结果)。",
            "in": "query",
            "name": "event_type",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/AuthEventType"
            }
          },
          {
            "in": "query",
            "name": "outcome",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/AuthOutcome"
            }
          },
          {
            "description": "联合模糊搜:`actor`(展示用户名/标识)+ `identifier_attempted`(失败场景提交的用户名/邮箱)\n+ `ip`(文本),大小写不敏感子串。**下推到库**(全历史检索),取代前端内存过滤。空 = 不搜。",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "精确 IP 过滤(`ip = X`)。与 `q` 的子串搜互补;两者都给则 AND 组合。强类型 `IpAddr`:\n非法值在 Query 提取器被拒 → 400(而非把裸串 cast 成 `::inet` 让 PG 抛 500;亦对齐内存侧规范化比较)。\nOpenAPI 里仍呈现为 string(utoipa 无 `IpAddr` schema)。",
            "in": "query",
            "name": "ip",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_AuthEventRow"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 audit:read 权限(superadmin 独占)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "审计后端未接线(无 search 投影库)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "page 与 cursor 互斥"
          }
        },
        "security": [
          {
            "oauth2": [
              "audit:read"
            ]
          }
        ],
        "summary": "全局认证审计流(后台安全排障用)。",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/admin/auth/auth-events/stats": {
      "get": {
        "operationId": "stats_auth_events",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStats"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 audit:read 权限(superadmin 独占)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "审计后端未接线(无 search 投影库)"
          }
        },
        "security": [
          {
            "oauth2": [
              "audit:read"
            ]
          }
        ],
        "summary": "认证审计仪表盘(时间序列 + 各维度 group-by 计数 + KPI)。默认区间最近 24h。",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/admin/auth/auth-events/stream": {
      "get": {
        "operationId": "stream_auth_events",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/AuthEventRow"
                }
              }
            },
            "description": "SSE 事件流;event = auth_event,data = AuthEventRow JSON"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 audit:read 权限(superadmin 独占)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "审计后端未接线(无 search 投影库)"
          }
        },
        "security": [
          {
            "oauth2": [
              "audit:read"
            ]
          }
        ],
        "summary": "认证事件实时推送(SSE)。projector 落库成功后立即推送;镜像 `widget` 的 `widget_events` handler\n的鉴权/心跳范式。best-effort 无回放:断线期间的事件丢失,EventSource 自动重连拿新订阅。\nponytail:总线是单 idm 实例内广播,见 `AuthEventBus` 头注(多实例扇出需换 JetStream 直连)。",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/admin/auth/login": {
      "post": {
        "operationId": "admin_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "后台登录成功,token 写入 httponly cookie。进入的上下文:有效成员关系里按最近使用挑第一个有 admin:login 的租户;都没有而有平台级权限 → 平台上下文(无当前租户)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "用户名/邮箱或密码错误(同码同文案,防枚举)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "凭据正确但无后台准入,不发 token 不设 cookie:一个有效成员关系都没有、也没有平台级权限 → `tenant_required`;有成员关系但哪个租户里都没有 admin:login(也没有平台级权限)→ `forbidden`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败"
          }
        },
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/auth/me": {
      "get": {
        "operationId": "admin_get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "组闸:无 admin:login(后台准入)"
          }
        },
        "security": [
          {
            "oauth2": [
              "admin:login"
            ]
          },
          {
            "oauth2": [
              "users:admin"
            ]
          },
          {
            "oauth2": [
              "tenants:admin"
            ]
          },
          {
            "oauth2": [
              "ops:read"
            ]
          },
          {
            "oauth2": [
              "audit:read"
            ]
          },
          {
            "oauth2": [
              "platform:roles"
            ]
          },
          {
            "oauth2": [
              "profiles:read"
            ]
          },
          {
            "oauth2": [
              "profiles:write"
            ]
          },
          {
            "oauth2": [
              "profiles:write:all"
            ]
          }
        ],
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/auth/members": {
      "get": {
        "operationId": "list_members",
        "parameters": [
          {
            "description": "提供 ⇒ offset 模式(可跳页),1-based。",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "提供 ⇒ cursor 模式;opaque token,原样回传、勿解析。空值 `cursor=` = 首页。\nserde_html_form 基座(见 infra/http/extract.rs)会把空值 Option 解成 None,丢掉\n\"cursor 模式首页\"的表达 —— 自定义 deserializer 保住 `Some(\"\")`。",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "每页条数,两模式共用;越界自动 clamp 到 [1,100]。",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "仅 offset 有意义:是否计算 total(默认 true)。",
            "in": "query",
            "name": "with_total",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "用户名 + 显示名模糊搜索(仅接了 search 投影后端时可用;未接 → 422)。",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_MemberView"
                }
              }
            },
            "description": "成员分页列表(display_name / avatar 富化,缺则 null)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 members:read 权限 / 没有当前租户(tenant_required)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "q 但无 search 投影后端"
          }
        },
        "security": [
          {
            "oauth2": [
              "members:read",
              "admin:login"
            ]
          },
          {
            "oauth2": [
              "members:read",
              "users:admin"
            ]
          },
          {
            "oauth2": [
              "members:read",
              "tenants:admin"
            ]
          },
          {
            "oauth2": [
              "members:read",
              "ops:read"
            ]
          },
          {
            "oauth2": [
              "members:read",
              "audit:read"
            ]
          },
          {
            "oauth2": [
              "members:read",
              "platform:roles"
            ]
          },
          {
            "oauth2": [
              "members:read",
              "profiles:read"
            ]
          },
          {
            "oauth2": [
              "members:read",
              "profiles:write"
            ]
          },
          {
            "oauth2": [
              "members:read",
              "profiles:write:all"
            ]
          }
        ],
        "summary": "本租户的成员列表(替代旧的后台「用户」页;数据来自租户成员索引,没接 search 时读 idm)。\n默认 offset;带 `cursor` 切 keyset。`q`(用户名 + 显示名模糊)仅接了 search 投影后端时可用,未接 → 422。",
        "tags": [
          "members"
        ]
      },
      "post": {
        "operationId": "add_member",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberView"
                }
              }
            },
            "description": "已加入本租户"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 members:admin 权限 / 授出的角色超出自己的权限 / 对方持平台角色(要 platform:roles)/ 没有当前租户"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "account_not_found:没有这个用户名的账号"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "已是本租户成员"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败 / 平台角色"
          }
        },
        "security": [
          {
            "oauth2": [
              "members:admin",
              "admin:login"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "users:admin"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "tenants:admin"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "ops:read"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "audit:read"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "platform:roles"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "profiles:read"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "profiles:write"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "profiles:write:all"
            ]
          }
        ],
        "summary": "按**完整用户名**把已有账号加进本租户(spec §4.5)。精确匹配(邮箱、大小写不同都不算),查不到 → 404\n`account_not_found`(不建账号:账号由平台管理员建)。只能授租户角色,且不能授出自己没有的权限。\n对方持平台角色(superadmin / 平台管理员)→ 要 `platform:roles`(与「移出」同一口径:组织管理员加进来就移不走)。",
        "tags": [
          "members"
        ]
      }
    },
    "/api/v1/admin/auth/members/{user_id}": {
      "delete": {
        "operationId": "remove_member",
        "parameters": [
          {
            "description": "user id",
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "已移出,本租户里的会话已吊销"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 members:admin 权限 / 越权 / 目标持平台角色(要 platform:roles)/ 没有当前租户"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "不是本租户的成员"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "不能移出自己"
          }
        },
        "security": [
          {
            "oauth2": [
              "members:admin",
              "admin:login"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "users:admin"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "tenants:admin"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "ops:read"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "audit:read"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "platform:roles"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "profiles:read"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "profiles:write"
            ]
          },
          {
            "oauth2": [
              "members:admin",
              "profiles:write:all"
            ]
          }
        ],
        "summary": "把某成员移出本租户,并立即吊销他在本租户的会话(他在别的租户的成员关系 / 会话不动;账号本身不删)。\n别的租户的成员 / 不是成员 → 404;不能移出自己(409);不能移出权限比自己大的成员(403)。",
        "tags": [
          "members"
        ]
      }
    },
