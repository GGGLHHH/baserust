            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "提供 ⇒ cursor 模式;opaque token,原样回传、勿解析。空值 `cursor=` = 首页。\nserde_html_form 基座(见 infra/http/extract.rs)会把空值 Option 解成 None,丢掉\n\"cursor 模式首页\"的表达 —— 自定义 deserializer 保住 `Some(\"\")`。",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "每页条数,两模式共用;越界自动 clamp 到 [1,100]。",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "仅 offset 有意义:是否计算 total(默认 true)。",
            "in": "query",
            "name": "with_total",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "用户名模糊(ILIKE 子串)。",
            "in": "query",
            "name": "username",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "用户名 + 显示名模糊搜索(仅投影/search 后端支持;无后端 → 422)。",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "正选:含任一角色(重复 key,如 `?role=admin&role=user`)。",
            "explode": true,
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/RoleName"
              },
              "type": "array"
            },
            "style": "form"
          },
          {
            "description": "反选:不含任一角色。",
            "explode": true,
            "in": "query",
            "name": "role_not",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/RoleName"
              },
              "type": "array"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "created_from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "created_to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort_by",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/UserSortField"
            }
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_AdminUserView"
                }
              }
            },
            "description": "用户分页列表(display_name/avatar 富化,缺则 null)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 users:admin 权限(仅 superadmin)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "cursor 分页 + 非默认 sort_by;或 q/sort_by=display_name 但无 search 投影后端"
          }
        },
        "security": [
          {
            "oauth2": [
              "users:admin"
            ]
          }
        ],
        "summary": "分页列出用户(过滤 + 排序 + 富化)。默认 offset;带 `cursor` 切 keyset。\n**平台账号列表**:不论当前租户,列全部账号(不属于任何租户的也在),角色列 / `roles_any` / `roles_none` 都是平台角色。\n接了 search 投影读全局账号目录,没接读 idm。租户成员列表是另外的接口。\ncursor + 非默认 sort_by → 422(keyset 恒按 id 序,非默认排序只能配 offset)。\n`q`(用户名 + 显示名模糊)与 `sort_by=display_name` 仅在接了 search 投影后端时可用;\n未接后端时二者 → 422(回退路只能 idm 直查,不具备搜索能力)。",
        "tags": [
          "users"
        ]
      },
      "post": {
        "operationId": "create_user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserView"
                }
              }
            },
            "description": "已创建(新号 display_name=null)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 users:admin 权限"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "username/email 已占用"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败 / 未知角色名"
          }
        },
        "security": [
          {
            "oauth2": [
              "users:admin"
            ]
          }
        ],
        "summary": "建号(原子含角色)。`by` = 当前 superadmin。",
        "tags": [
          "users"
        ]
      }
    },
