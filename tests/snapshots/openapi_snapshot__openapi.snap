        ],
        "type": "object"
      },
      "MyPermissionsResponse": {
        "description": "`GET /permissions/me` 响应。`roles` 来自 token claim;`permissions` 是**有效**集:\n(平台角色给的平台级 ∪ 当前租户角色给的租户级,含 implies)∩ scope 收窄,wire 串排序输出。",
        "properties": {
          "permissions": {
            "description": "有效权限(闭集,wire 串序输出)。前端按钮显隐 / codegen accessPolicies `has()` 的数据源。",
            "items": {
              "$ref": "#/components/schemas/Perm"
            },
            "type": "array"
          },
          "roles": {
            "description": "token claim 里的**平台角色**名(闭集,生成前端 union)。",
            "items": {
              "$ref": "#/components/schemas/RoleName"
            },
            "type": "array"
          },
          "tenant": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrentTenantView",
                "description": "当前租户;平台上下文(没加入任何组织 / 平台管理员)→ `null`。"
              }
            ]
          },
          "tenant_roles": {
            "description": "当前租户内的角色名(平台上下文 → 空)。",
            "items": {
              "$ref": "#/components/schemas/RoleName"
            },
            "type": "array"
          }
        },
        "required": [
          "roles",
          "tenant_roles",
          "permissions"
        ],
        "type": "object"
      },
      "MyTenantView": {
        "description": "我的一个租户(`GET /auth/tenants` 的元素):当前账号**有效**的成员关系。",
