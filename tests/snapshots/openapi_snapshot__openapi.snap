        "summary": "后台读某用户资料(display_name/phone/avatar)。归 `users:admin`。资料未建 → 404。",
        "tags": [
          "users"
        ]
      },
      "put": {
        "operationId": "set_user_profile",
        "parameters": [
          {
            "description": "user id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "已更新"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 users:admin 权限 / 目标持平台角色而无 platform:roles"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败 / 头像非法"
          }
        },
        "security": [
          {
            "oauth2": [
              "users:admin"
            ]
          }
        ],
        "summary": "后台改某用户资料(PUT 全量:display_name/phone/avatar_content_id)。归 `users:admin`。",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/admin/auth/users/{id}/roles": {
      "put": {
        "operationId": "set_user_roles",
        "parameters": [
          {
            "description": "user id",
            "in": "path",
            "name": "id",
