    "/api/v1/admin/platform/tenants/{id}/members/{user_id}": {
      "delete": {
        "operationId": "remove_tenant_member",
        "parameters": [
          {
            "description": "tenant id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "user id",
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "已移出,该租户里的会话已吊销"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 tenants:admin 权限 / 移出持平台角色的账号而无 platform:roles"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "租户不存在 / 不是该租户的成员"
          }
        },
        "security": [
          {
            "oauth2": [
              "tenants:admin"
            ]
          }
        ],
        "summary": "把某人移出某租户,并立即吊销他在该租户的会话。租户不存在 / 不是成员 → 404。",
        "tags": [
          "tenants"
        ]
      },
      "put": {
        "operationId": "put_tenant_member",
        "parameters": [
          {
            "description": "tenant id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "user id",
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberRolesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberView"
                }
              }
            },
            "description": "已加入 / 已更新"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 tenants:admin 权限 / 改持平台角色的成员而无 platform:roles"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "租户或账号不存在"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败 / 平台角色"
          }
        },
        "security": [
          {
            "oauth2": [
              "tenants:admin"
            ]
          }
        ],
        "summary": "设某租户的成员(PUT:不是成员则加入,是成员则全量替换租户角色)。用于给新租户指定第一个管理员。\n只能授租户角色(平台角色 → 422)。租户 / 账号不存在 → 404。",
        "tags": [
          "tenants"
        ]
      }
    },
    "/api/v1/admin/widgets": {
      "get": {
        "description": "准入 = admin 组闸(后台准入)+ 租户级 `widgets:read` —— 租户管理员(租户角色 admin)就能看,不要平台级权限(租户数据的后台接口不拿平台权限当闸,spec §4.3)。\n可见域照旧:有当前租户角色给的 `widgets:read:all` → 本租户全部,否则只列自己建的\n(平台管理员在某租户里只是普通成员时也一样)。数据限当前租户(缺 → 403 `tenant_required`)。",
        "operationId": "admin_list_widgets",
        "parameters": [
          {
            "description": "提供 ⇒ offset 模式(可跳页),1-based。",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "提供 ⇒ cursor 模式;opaque token,原样回传、勿解析。空值 `cursor=` = 首页。\nserde_html_form 基座(见 infra/http/extract.rs)会把空值 Option 解成 None,丢掉\n\"cursor 模式首页\"的表达 —— 自定义 deserializer 保住 `Some(\"\")`。",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "每页条数,两模式共用;越界自动 clamp 到 [1,100]。",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "仅 offset 有意义:是否计算 total(默认 true)。",
            "in": "query",
            "name": "with_total",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "sort_by",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/WidgetSortField"
            }
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_WidgetView"
                }
              }
            },
            "description": "当前租户内;无租户级 read:all 时只含本人创建的(富化)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无后台准入(admin 组闸)/ 无 widgets:read 权限 / 没有当前租户(tenant_required)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "cursor 分页 + 非默认 sort_by(仅 offset 支持排序)"
          }
        },
        "security": [
          {
            "oauth2": [
              "widgets:read",
              "admin:login"
            ]
          },
          {
            "oauth2": [
              "widgets:read",
              "users:admin"
            ]
          },
          {
            "oauth2": [
              "widgets:read",
              "tenants:admin"
            ]
          },
          {
            "oauth2": [
              "widgets:read",
              "ops:read"
            ]
          },
          {
            "oauth2": [
              "widgets:read",
              "audit:read"
            ]
          },
          {
            "oauth2": [
              "widgets:read",
              "platform:roles"
            ]
          },
          {
            "oauth2": [
              "widgets:read",
              "profiles:read"
            ]
          },
          {
            "oauth2": [
              "widgets:read",
              "profiles:write"
            ]
          },
          {
            "oauth2": [
              "widgets:read",
              "profiles:write:all"
            ]
          }
        ],
        "summary": "**后台 widget 列表**:列出**当前租户**的 widget(富化创建人)。",
        "tags": [
          "widgets"
        ]
      }
    },
