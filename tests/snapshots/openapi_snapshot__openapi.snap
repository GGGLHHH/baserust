    "/api/v1/admin/auth/users/{id}/auth-events": {
      "get": {
        "operationId": "list_user_auth_events",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "提供 ⇒ offset 模式(可跳页),1-based。",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "提供 ⇒ cursor 模式;opaque token,原样回传、勿解析。空值 `cursor=` = 首页。\nserde_html_form 基座(见 infra/http/extract.rs)会把空值 Option 解成 None,丢掉\n\"cursor 模式首页\"的表达 —— 自定义 deserializer 保住 `Some(\"\")`。",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "每页条数,两模式共用;越界自动 clamp 到 [1,100]。",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "仅 offset 有意义:是否计算 total(默认 true)。",
            "in": "query",
            "name": "with_total",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "事件类型(闭集;未知值在 Query 提取器被拒 → 400 bad_request,而非静默空结果)。",
            "in": "query",
            "name": "event_type",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/AuthEventType"
            }
          },
          {
            "in": "query",
            "name": "outcome",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/AuthOutcome"
            }
          },
          {
            "description": "联合模糊搜:`actor`(展示用户名/标识)+ `identifier_attempted`(失败场景提交的用户名/邮箱)\n+ `ip`(文本),大小写不敏感子串。**下推到库**(全历史检索),取代前端内存过滤。空 = 不搜。",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "精确 IP 过滤(`ip = X`)。与 `q` 的子串搜互补;两者都给则 AND 组合。强类型 `IpAddr`:\n非法值在 Query 提取器被拒 → 400(而非把裸串 cast 成 `::inet` 让 PG 抛 500;亦对齐内存侧规范化比较)。\nOpenAPI 里仍呈现为 string(utoipa 无 `IpAddr` schema)。",
            "in": "query",
            "name": "ip",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_AuthEventRow"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 audit:read 权限(superadmin 独占)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "审计后端未接线(无 search 投影库)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "page 与 cursor 互斥"
          }
        },
        "security": [
          {
            "oauth2": [
              "audit:read"
            ]
          }
        ],
        "summary": "某用户的认证事件历史(后台用户详情页 / 排障用)。",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/admin/auth/users/{id}/avatar": {
      "post": {
        "operationId": "set_user_avatar",
        "parameters": [
          {
