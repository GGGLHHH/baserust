            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "errors_4xx": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "errors_5xx": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "in_flight": {
            "format": "int64",
            "type": "integer"
          },
          "outbox_published": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "p95_ms": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "pool_in_use": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "pool_max": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "projector_pending": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "projector_processed": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "requests": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "rss_bytes": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "sse_connections": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "at",
          "requests",
          "errors_4xx",
          "errors_5xx",
          "in_flight",
          "db_calls",
          "pool_in_use",
          "pool_max",
          "sse_connections",
          "outbox_published",
          "projector_processed",
          "projector_pending"
        ],
        "type": "object"
      },
      "HistoryRange": {
        "description": "历史时间范围。",
        "enum": [
          "24h",
          "7d",
          "30d",
          "90d",
          "1y"
        ],
        "type": "string"
      },
      "HistoryReport": {
        "description": "历史报告:按进程分组的曲线 + 整个范围的合计 + 接口 / 数据库明细。",
        "properties": {
          "details_from": {
            "description": "接口 / 数据库明细的起点:明细只留 30 天,范围更长时只覆盖最近 30 天。",
            "format": "date-time",
            "type": "string"
          },
          "from": {
            "format": "date-time",
            "type": "string"
          },
          "instances": {
            "items": {
              "$ref": "#/components/schemas/HistoryInstance"
            },
            "type": "array"
          },
          "persistent": {
            "description": "数据是否持久化。`false` = 没配 ops 数据库,只有进程内存里最近一段(重启清空)。",
            "type": "boolean"
          },
          "range": {
            "$ref": "#/components/schemas/HistoryRange"
          },
          "step_secs": {
            "description": "曲线上一个点代表的秒数。",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "to": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "range",
          "from",
          "to",
          "step_secs",
          "persistent",
          "details_from",
          "instances"
        ],
        "type": "object"
      },
      "InstanceReport": {
        "description": "单个进程的监控数据。计数类字段(请求数、发布数…)都是**统计窗口内**的值:\n窗口 = 进程内存里保留的最近一段(默认 1 小时),进程刚启动时从启动算起。",
        "properties": {
          "checks": {
            "description": "依赖检查(与 `/readyz` 同源)。",
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "type": "array"
          },
          "db_operations": {
            "description": "按数据库操作(仓储方法)统计,按调用次数降序。",
            "items": {
              "$ref": "#/components/schemas/DbOperationStats"
            },
            "type": "array"
          },
          "error": {
            "description": "拉取失败的原因。",
            "type": [
              "string",
              "null"
            ]
          },
          "history": {
            "description": "历史曲线(每个点是一个采样间隔内的增量或当时的读数),时间升序。",
            "items": {
              "$ref": "#/components/schemas/HistoryPoint"
            },
            "type": "array"
          },
          "in_flight": {
            "description": "正在处理的请求数。",
            "format": "int64",
            "type": "integer"
          },
          "outbox": {
            "items": {
              "$ref": "#/components/schemas/OutboxStatus"
            },
            "type": "array"
          },
          "pools": {
            "items": {
              "$ref": "#/components/schemas/PoolStatus"
            },
            "type": "array"
          },
          "process": {
            "$ref": "#/components/schemas/ProcessStatus"
          },
          "projectors": {
            "items": {
              "$ref": "#/components/schemas/ProjectorStatus"
            },
            "type": "array"
          },
          "reachable": {
            "description": "拉取这个进程的报告是否成功(app 汇总 idm 时可能失败)。失败时其余字段为空值。",
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/InstanceRole"
          },
          "routes": {
            "description": "按接口(路由模板)统计,按请求数降序。",
            "items": {
              "$ref": "#/components/schemas/RouteStats"
            },
            "type": "array"
          },
          "sample_interval_secs": {
            "description": "历史曲线的采样间隔(秒)。",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "sse": {
            "items": {
              "$ref": "#/components/schemas/SseStatus"
            },
            "type": "array"
          },
          "started_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "traffic": {
            "$ref": "#/components/schemas/TrafficSummary"
          },
          "uptime_secs": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "type": "string"
          },
          "window_secs": {
            "description": "统计窗口长度(秒)。",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "role",
          "reachable",
          "version",
          "uptime_secs",
          "window_secs",
          "sample_interval_secs",
          "checks",
          "process",
          "in_flight",
          "pools",
          "sse",
          "traffic",
          "routes",
          "db_operations",
          "outbox",
          "projectors",
          "history"
        ],
        "type": "object"
      },
      "InstanceRole": {
        "description": "实例角色。",
        "enum": [
          "app",
          "idm",
          "combined"
        ],
        "type": "string"
      },
      "IpStat": {
        "properties": {
          "failures": {
            "format": "int64",
            "type": "integer"
          },
          "ip": {
            "type": "string"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
