          "failures",
          "total"
        ],
        "type": "object"
      },
      "LogRecordView": {
        "description": "一条日志。",
        "properties": {
          "attributes": {
            "description": "其余结构化字段(敏感字段已脱敏)。",
            "type": "object"
          },
          "body": {
            "type": "string"
          },
          "duration_ms": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "instance": {
            "$ref": "#/components/schemas/InstanceRole"
          },
          "method": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "service": {
            "$ref": "#/components/schemas/Service",
            "description": "归属服务(app / idm)。"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "target": {
            "description": "产生日志的模块(`http.access` = 失败 / 慢请求记录)。",
            "type": "string"
          },
          "ts": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ts",
          "instance",
          "service",
          "severity",
          "target",
          "body",
          "attributes"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "description": "登录请求(公开)。`identifier` = username 或 email,由 idm 自动识别。",
        "properties": {
          "identifier": {
            "description": "上限 320 = email 的最大合法长度(64 local + @ + 255 domain);username 上限 32 更窄,取宽的那个。\n**必须有上限**:登录失败时本字段被原样写进审计事件(`identifier_attempted`),经 outbox →\nNATS → 投影落 `auth_events`,而这条路是**未认证**可达的。没上限时唯一的界是 axum 的 2MB\nbody 上限(限流还是 opt-in),等于放任匿名者每次瞎登录就持久化 ~2MB 攻击者可控文本;\n这些行之后还会被后台 `q` 过滤 ILIKE 全表扫,成本反复付。",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ],
        "type": "object"
      },
      "MemberRolesRequest": {
        "description": "全量设成员的租户角色(原子替换;只能是租户角色,平台角色 → 422)。",
        "properties": {
          "roles": {
            "items": {
              "$ref": "#/components/schemas/TenantRoleName"
            },
            "type": "array"
          }
        },
        "required": [
          "roles"
        ],
        "type": "object"
      },
      "MemberStatus": {
        "description": "成员状态闭集",
        "enum": [
          "active",
          "inactive"
        ],
        "type": "string"
      },
      "MemberView": {
        "description": "租户成员:账号 + 该租户里的租户角色 / 成员状态 + 富化的资料(缺 → null)。",
        "properties": {
          "avatar_url": {
            "description": "富化:相对头像端点路径(缺 → null)。",
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "description": "富化:显示名(缺 → null)。",
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "holds_platform_role": {
            "description": "该账号持有任一平台角色(superadmin / 平台管理员)。这样的成员只有持 `platform:roles` 的人能改角色 / 移出\n(防接管,否则 403);前端据此隐藏按钮。",
            "type": "boolean"
          },
          "id": {
            "description": "账号 id(user id)。",
            "format": "uuid",
            "type": "string"
          },
          "roles": {
            "description": "该租户里的租户角色(闭集)。",
            "items": {
              "$ref": "#/components/schemas/TenantRoleName"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/MemberStatus"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "roles",
          "status",
          "holds_platform_role"
        ],
        "type": "object"
      },
      "MonitoringReport": {
        "description": "整体报告:每个进程一份。",
        "properties": {
          "generated_at": {
            "format": "date-time",
