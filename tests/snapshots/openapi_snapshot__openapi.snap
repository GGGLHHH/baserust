        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/frontend/profiles/me": {
      "get": {
        "description": "**不 404**:未建资料 → 200 + 空资料(时间戳 null),前端照常渲染空表单、保存即 PUT 建行。\n与按 id 读(`get_profile`)刻意不同,理由见 `ProfileService::get_or_empty`。",
        "operationId": "get_my_profile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "自己的资料;尚未建则各段为 null(user_id 仍是本人,前端据此 PUT 建资料)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ],
        "summary": "读**请求者自己**的资料(仅登录,零 perm —— \"自己\"是身份事实不是授权决策,\n对齐 `get_me`/`my_widget_count` 的自我操作范式;`profiles:read` 留给\"读任意人\")。\n静态段 `/profiles/me` 与参数段 `/profiles/{user_id}` 共存,axum 静态优先。",
        "tags": [
          "profiles"
        ]
      },
      "put": {
        "operationId": "put_my_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "已替换"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "首次建立"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败(超长 / 头像不是本人的个人内容 / 未 confirm / 非栅格图)"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ],
        "summary": "全量替换 upsert **自己**的资料(仅登录,零 perm;不要当前租户 —— 资料全局一份)。\n未建 → 201,已有 → 200。头像只能绑本人的个人内容(`POST /profiles/me/avatar` 传的那种)。",
        "tags": [
          "profiles"
        ]
      }
    },
    "/api/v1/frontend/profiles/me/avatar": {
      "post": {
        "operationId": "upload_my_avatar",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "description": "传头像的 multipart 表单形状(只为 OpenAPI 文档,handler 逐字段手解)。",
                "properties": {
                  "file": {
                    "description": "图片本体(必填,带 filename + content-type,须 image/*)。",
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "头像已上传并绑定"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "multipart 解析失败"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "缺 file 部分 / 非栅格图"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ],
        "summary": "传**自己**的头像(multipart 表单,`file` 部分为栅格图)。仅登录,零 perm,不要当前租户。\n存成个人内容(`ContentScope::Personal`,owner = 本人,不属于任何租户)并立即绑定(保留 display_name / phone),\n返回更新后的资料。换下来的旧头像(本人的个人内容)会被 best-effort 软删(见 `upload_and_bind_avatar`)。",
        "tags": [
          "profiles"
        ]
      }
    },
    "/api/v1/frontend/profiles/{user_id}": {
      "get": {
        "operationId": "get_profile",
        "parameters": [
          {
            "description": "idm user id(1:1)",
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "资料(avatar_url 为相对 preview 路径;悬空/未就绪 → null)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 profiles:read 权限(平台级)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "该用户尚未建资料"
          }
        },
        "security": [
          {
            "oauth2": [
              "profiles:read"
            ]
          }
        ],
        "summary": "按 id 读任意用户的资料(需 `profiles:read`,**平台级**:只有平台管理员有)。\n响应含 phone 等 PII,且资料跨租户全局一份 —— 所以不给租户成员;本人读自己走 `/profiles/me`。",
        "tags": [
          "profiles"
        ]
      },
      "put": {
        "operationId": "put_profile",
        "parameters": [
          {
            "description": "idm user id(1:1)",
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "已替换"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description": "首次建立"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 profiles:write / 改别人无 write:all(平台级)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败(超长 / 头像不是目标本人的个人内容 / 未 confirm / 非栅格图)"
          }
        },
        "security": [
          {
            "oauth2": [
              "profiles:write"
            ]
          }
        ],
        "summary": "按 id 全量替换 upsert 资料(`profiles:write`,**平台级**);带 `profiles:write:all` 可替任何人。\n未建 → 201,已有 → 200(PUT 即建即替,RFC 7231 本义;profile 无独立 POST)。本人改自己走 `PUT /profiles/me`。",
        "tags": [
          "profiles"
        ]
      }
    },
    "/api/v1/frontend/profiles/{user_id}/avatar": {
      "get": {
        "operationId": "get_user_avatar",
        "parameters": [
          {
            "description": "idm user id(1:1)",
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "inline 图片字节(代理回退)"
          },
          "307": {
            "description": "跳转到短时效签名 URL(presign 后端)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无资料 / 未绑定头像 / 头像不可用"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ],
        "summary": "用户头像展示端点(**跨用户可见**:任意登录用户都能看别人的头像 —— 头像是 profile 刻意暴露\n的单张公开图,与\"content 本体严格按 owner 隔离\"分开)。读该用户的 avatar_content_id → 出字节。\n无资料 / 未绑定头像 / 头像 content 已删或未就绪 → 404。\n**只服务被指定为头像的那个 content**(且 put 已校验 owner==本人、image/*),故不重开\n`contents/{id}/preview` 那种\"任意 image 越权读\"的面。仅需登录(头像非敏感展示数据,不额外要 contents:read)。",
        "tags": [
          "profiles"
        ]
      }
    },
    "/api/v1/frontend/widgets": {
      "get": {
        "operationId": "list_widgets",
        "parameters": [
          {
            "description": "提供 ⇒ offset 模式(可跳页),1-based。",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "提供 ⇒ cursor 模式;opaque token,原样回传、勿解析。空值 `cursor=` = 首页。\nserde_html_form 基座(见 infra/http/extract.rs)会把空值 Option 解成 None,丢掉\n\"cursor 模式首页\"的表达 —— 自定义 deserializer 保住 `Some(\"\")`。",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "每页条数,两模式共用;越界自动 clamp 到 [1,100]。",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "仅 offset 有意义:是否计算 total(默认 true)。",
            "in": "query",
            "name": "with_total",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "sort_by",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/WidgetSortField"
            }
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_WidgetView"
                }
              }
            },
            "description": "widget 分页列表(按所有权过滤,created_by 富化为用户)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 widgets:read 权限 / 没有当前租户(tenant_required)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "cursor 分页 + 非默认 sort_by(仅 offset 支持排序)"
          }
        },
        "security": [
          {
            "oauth2": [
              "widgets:read"
            ]
          }
        ],
        "summary": "分页列出 widget。**user 只列自己创建的**(read:all → 全部)。默认 offset;带 `cursor` 切 keyset。",
        "tags": [
          "widgets"
        ]
      },
      "post": {
        "operationId": "create_widget",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWidget"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            },
            "description": "已创建"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 widgets:write 权限 / 没有当前租户(tenant_required)"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "name 已存在(本租户存活行内唯一)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "校验失败"
          }
        },
        "security": [
          {
            "oauth2": [
              "widgets:write"
            ]
          }
        ],
        "summary": "创建一个 widget(需 `widgets:write`)。审计主体(created_by)= 当前登录用户,来自 `AuditContext`。",
        "tags": [
          "widgets"
        ]
      }
    },
    "/api/v1/frontend/widgets/events": {
      "get": {
        "description": "**先比租户、再比 owner**:总线是全实例广播(不分租户、不分频道),过滤落在本 handler —— 逐帧先看\n`event.tenant_id() == 当前租户`,再 `allows_created_by`,不过就跳帧(`continue`),**不**结束流。\n租户这一道在前:`read:all` 的 admin 也只是「本租户全部」,别的租户的帧一律看不见。没这层,无 `read:all` 的 `user`\n能从流里读到 `list_widgets`/`get_widget` 都不给他看的**别人的 widget**(名字等全量 `Widget`)。\n`Access` 在开流时刻算定并随流存活 —— 同下面的鉴权时刻取舍。\n\n鉴权只在开流时刻评估:流存活期间 token 过期/吊销不会断流(SSE 惯例取舍;低敏数据可接受)。\n要收紧:按 claim 的 exp 到点结束流,EventSource 重连即重新鉴权。",
        "operationId": "widget_events",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetEvent"
                }
              }
            },
            "description": "SSE 事件流;每帧 event = type(created/updated/deleted),data = WidgetEvent JSON"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "无 widgets:read 权限 / 没有当前租户(tenant_required)"
          }
        },
        "security": [
          {
            "oauth2": [
              "widgets:read"
            ]
          }
        ],
        "summary": "订阅 widget 变更事件流(SSE)。需登录 + `widgets:read` —— 与列表同权:能看列表就能看变更。\nEventSource 不能自定义 header,凭据靠 httponly cookie(Bearer 兜底给 curl/测试)。\nbest-effort 无回放:断线期间的事件丢失,EventSource 自动重连拿新订阅。",
        "tags": [
          "widgets"
        ]
      }
    },
    "/api/v1/frontend/widgets/my-count": {
      "get": {
        "operationId": "my_widget_count",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetStats"
                }
              }
            },
            "description": "当前用户在当前租户里创建的 widget 数"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "没有当前租户(tenant_required)"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ],
        "summary": "**仅登录**(authenticated):当前用户在**当前租户**里创建的 widget 数。要 `CurrentUser`、**无特定 perm**\n(`OP_PERMS` 标 `None` → 文档 `security:[{\"oauth2\":[]}]`)。演示\"只需登录\"形态。\n数的是租户数据,所以仍要当前租户(平台上下文 → 403 `tenant_required`)。",
        "tags": [
          "widgets"
        ]
      }
    },
    "/api/v1/frontend/widgets/overview": {
      "get": {
        "operationId": "widget_overview",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetStats"
                }
              }
            },
            "description": "当前租户的 widget 计数(读权或本组织成员管理员)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "widgets:read 与 members:admin 皆无 / 没有当前租户(tenant_required)"
          }
        },
        "security": [
          {
            "oauth2": [
              "widgets:read"
            ]
          },
          {
            "oauth2": [
              "members:admin"
            ]
          }
        ],
        "summary": "**多权限 OR 样板**:概览 —— 普通读权**或**本组织成员管理员(`members:admin`)任一即可。\n两支都是租户级权限:租户数据的接口不拿平台级权限(如 `users:admin`)当闸(spec §4.3)。\n`require_any` 全败才 403;文档 = 多 requirement 各一 scope(`PermReq::Any`)。",
        "tags": [
          "widgets"
        ]
      }
    },
    "/api/v1/frontend/widgets/purge-preview": {
      "get": {
        "operationId": "purge_preview",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetStats"
                }
              }
            },
            "description": "本人可见域内可删 widget 计数"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "缺 widgets:read 或 widgets:delete 任一 / 没有当前租户(tenant_required)"
          }
        },
        "security": [
          {
            "oauth2": [
              "widgets:read",
              "widgets:delete"
            ]
          }
        ],
        "summary": "**多权限 AND 样板**:删除预检 —— 读得见**且**删得动才允许看\"可删多少\"。\n`require_all` 缺任一 perm 即 403;文档 = 单 requirement 多 scope(`OP_PERMS` 的 `PermReq::All`)。",
        "tags": [
          "widgets"
        ]
      }
    },
    "/api/v1/frontend/widgets/stats": {
      "get": {
        "description": "曾是免登录的「全站计数」:多租户下匿名请求没有租户,跨租户汇总要绕过 RLS,违背「租户互相看不见」,\n所以移到 frontend 组、只数当前租户。业务里要做公开数字,先想清楚它属于哪个租户。",
        "operationId": "widget_stats",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetStats"
                }
              }
            },
            "description": "当前租户的 widget 计数(仅登录)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "未认证"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "没有当前租户(tenant_required)"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ],
        "summary": "**仅登录**:当前租户的 widget 计数。要登录(frontend 组闸)+ 当前租户(`CurrentTenant`,缺 → 403\n`tenant_required`),**无特定 perm**(`OP_PERMS` 标 `LoginOnly`)。按租户计数走普通运行时池 + 租户事务。",
        "tags": [
          "widgets"
        ]
      }
    },
